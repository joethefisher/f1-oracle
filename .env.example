# Database (Supabase direct connection string)
# Find this in: Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# Anthropic (post-race analysis agent — optional)
ANTHROPIC_API_KEY=

# Telegram notifications (optional — unset = notifications silently disabled).
# 1. Create a bot via @BotFather to get the token.
# 2. Message your bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
TELEGRAM_API_TOKEN=
TELEGRAM_CHAT_ID=
